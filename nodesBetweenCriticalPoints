lass Solution:
    def nodesBetweenCriticalPoints(self, head: Optional[ListNode]) -> List[int]:
        prev = head
        curr = head.next    
        index = 1
        critical_indices = []

        while curr and curr.next:
            next_node = curr.next
            if (curr.val > prev.val and curr.val > next_node.val) or \
               (curr.val < prev.val and curr.val < next_node.val):
                critical_indices.append(index)
            prev = curr
            curr = next_node
            index += 1

        if len(critical_indices) < 2:
            return [-1, -1]

        min_dist = min(
            critical_indices[i+1] - critical_indices[i]
            for i in range(len(critical_indices) - 1)
        )
        max_dist = critical_indices[-1] - critical_indices[0]

        return [min_dist, max_dist]

        
